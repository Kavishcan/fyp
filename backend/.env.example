# Copy to backend/.env and fill in ONE provider. Demo/dev generation only —
# see backend/generation/base.py for why this departs from the research
# design (which specifies a local model to keep the trust boundary intact).
# Auto-detected in this order: LLM_PROVIDER override, then OPENAI_API_KEY,
# then GEMINI_API_KEY. Leave everything unset to keep answer: null.

# LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
